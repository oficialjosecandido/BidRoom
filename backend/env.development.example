# Development Environment Variables
NODE_ENV=development
PORT=3000

# MongoDB Configuration
MONGO_URI=mongodb+srv://josevcandido_db_user:<db_password>@clusterbr.pw2gswl.mongodb.net/bidroom_dev

# JWT Configuration
