{
  "subject": "You're in the Private Auction Room: {{listingTitle}}",
  "html": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"><style>:root{--primary:#7A4F84;--primary-dark:#5d3d66;--accent:#22c55e;--accent-hover:#16a34a;--text:#1a202c;--text-muted:#4a5568;--bg:#f8fafc;--card:#fff;--border:#e2e8f0}*{box-sizing:border-box}body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Oxygen,Ubuntu,sans-serif;line-height:1.6;color:var(--text);margin:0;padding:0;background:var(--bg)}.wrapper{max-width:560px;margin:0 auto;padding:24px}.card{background:var(--card);border-radius:16px;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,.08)}.hero{background:linear-gradient(135deg,var(--primary) 0%,var(--primary-dark) 100%);padding:40px 32px;text-align:center}.hero-icon{font-size:48px;margin-bottom:12px;display:block}.hero h1{margin:0;color:#fff;font-size:26px;font-weight:700;letter-spacing:-.5px}.hero p{margin:8px 0 0;color:rgba(255,255,255,.9);font-size:15px}.body{padding:32px}.greeting{font-size:18px;font-weight:600;color:var(--text);margin-bottom:24px}.invite-box{background:linear-gradient(180deg,#fffbf5 0%,#fff8eb 100%);border:1px solid #fde68a;border-radius:12px;padding:28px;margin:24px 0}.badge{display:inline-flex;align-items:center;gap:6px;background:var(--primary);color:#fff;padding:6px 14px;border-radius:999px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.8px;margin-bottom:16px}.badge::before{content:'⭐'}.invite-box h2{margin:0 0 12px;font-size:22px;color:var(--text);font-weight:700}.invite-box p{margin:0 0 16px;color:var(--text-muted);font-size:15px}.listing-title{font-size:20px;font-weight:700;color:var(--text);margin:16px 0;display:block}.details{display:flex;flex-direction:column;gap:12px;margin:20px 0}.detail-row{display:flex;justify-content:space-between;align-items:center;padding:12px 16px;background:#fff;border-radius:8px;border:1px solid var(--border)}.detail-label{font-weight:500;color:var(--text-muted);font-size:14px}.detail-value{font-weight:700;color:var(--text);font-size:16px}.detail-value.price{color:var(--accent)}.cta-wrap{text-align:center;margin:32px 0}.cta-btn{display:inline-block;padding:18px 36px;background:linear-gradient(135deg,var(--accent),var(--accent-hover));color:#fff!important;text-decoration:none;font-weight:600;font-size:16px;border-radius:10px;box-shadow:0 4px 14px rgba(34,197,94,.35);transition:transform .2s}.cta-btn:hover{transform:translateY(-1px)}.info{padding:20px;background:var(--bg);border-radius:10px;margin:24px 0}.info p{margin:0 0 8px;color:var(--text-muted);font-size:14px}.info p:last-child{margin-bottom:0}.info strong{color:var(--text)}.closing{margin-top:28px;padding-top:24px;border-top:1px solid var(--border)}.closing p{margin:4px 0;color:var(--text-muted)}.footer{text-align:center;padding:24px;background:var(--bg);font-size:12px;color:var(--text-muted)}</style></head><body><div class=\"wrapper\"><div class=\"card\"><div class=\"hero\"><span class=\"hero-icon\">🔒</span><h1>Private Auction Room</h1><p>You're invited as a Platinum Bidder</p></div><div class=\"body\"><p class=\"greeting\">Hello {{bidderName}},</p><div class=\"invite-box\"><span class=\"badge\">Platinum Bidder</span><h2>You're in!</h2><p>You have been selected to participate in an exclusive private auction room for:</p><span class=\"listing-title\">{{listingTitle}}</span><div class=\"details\"><div class=\"detail-row\"><span class=\"detail-label\">Current price</span><span class=\"detail-value price\">${{currentPrice}}</span></div><div class=\"detail-row\"><span class=\"detail-label\">Room starts</span><span class=\"detail-value\">{{endDate}}</span></div></div></div><p style=\"margin:20px 0;color:var(--text-muted);font-size:15px\">Accept within <strong>15 minutes</strong> to secure your seat. After accepting, you can place bids—each bid extends the room by 60 seconds.</p><div class=\"cta-wrap\"><a href=\"{{acceptInvitationUrl}}\" class=\"cta-btn\">Accept &amp; Join Room</a></div><div class=\"info\"><p><strong>What happens next?</strong></p><p>Click the button above to accept. Once accepted, you can place bids. Only invited bidders who accept in time can participate.</p></div><div class=\"closing\"><p>Best regards,</p><p><strong>The BidRoom Team</strong></p></div></div><div class=\"footer\"><p>This is an automated message. Please do not reply.</p></div></div></div></body></html>"
}
