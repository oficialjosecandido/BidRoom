{
  "subject": "You're invited to the Private Auction Room: {{listingTitle}}",
  "html": "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"><style>*{box-sizing:border-box}body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Oxygen,Ubuntu,sans-serif;line-height:1.6;color:#1a202c;margin:0;padding:0;background:#f8fafc}.wrapper{max-width:560px;margin:0 auto;padding:24px}.card{background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,.08)}.hero{background:linear-gradient(135deg,#7A4F84 0%,#5d3d66 100%);padding:40px 32px;text-align:center}.hero-icon{font-size:48px;margin-bottom:12px;display:block}.hero h1{margin:0;color:#fff;font-size:26px;font-weight:700;letter-spacing:-.5px}.hero p{margin:8px 0 0;color:rgba(255,255,255,.9);font-size:15px}.body{padding:32px}.greeting{font-size:18px;font-weight:600;color:#1a202c;margin-bottom:24px}.invite-box{background:linear-gradient(180deg,#fffbf5 0%,#fff8eb 100%);border:1px solid #fde68a;border-radius:12px;padding:28px;margin:24px 0}.badge{display:inline-flex;align-items:center;gap:6px;background:#7A4F84;color:#fff;padding:6px 14px;border-radius:999px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.8px;margin-bottom:16px}.invite-box h2{margin:0 0 12px;font-size:22px;color:#1a202c;font-weight:700}.invite-box p{margin:0 0 16px;color:#4a5568;font-size:15px}.listing-title{font-size:20px;font-weight:700;color:#1a202c;margin:16px 0;display:block}.details{display:flex;flex-direction:column;gap:12px;margin:20px 0}.detail-row{display:flex;justify-content:space-between;align-items:center;padding:12px 16px;background:#fff;border-radius:8px;border:1px solid #e2e8f0}.detail-label{font-weight:500;color:#4a5568;font-size:14px}.detail-value{font-weight:700;color:#1a202c;font-size:16px}.detail-value.price{color:#22c55e}.cta-wrap{text-align:center;margin:32px 0;display:flex;gap:16px;justify-content:center;flex-wrap:wrap}.cta-btn-accept{display:inline-block;padding:16px 32px;background:#22c55e;color:#fff!important;text-decoration:none;font-weight:700;font-size:16px;border-radius:10px;box-shadow:0 4px 14px rgba(34,197,94,.35)}.cta-btn-decline{display:inline-block;padding:16px 32px;background:#e53e3e;color:#fff!important;text-decoration:none;font-weight:700;font-size:16px;border-radius:10px;box-shadow:0 4px 14px rgba(229,62,62,.25)}.info{padding:20px;background:#f8fafc;border-radius:10px;margin:24px 0}.info p{margin:0 0 8px;color:#4a5568;font-size:14px}.info p:last-child{margin-bottom:0}.info strong{color:#1a202c}.closing{margin-top:28px;padding-top:24px;border-top:1px solid #e2e8f0}.closing p{margin:4px 0;color:#4a5568}.footer{text-align:center;padding:24px;background:#f8fafc;font-size:12px;color:#4a5568}</style></head><body><div class=\"wrapper\"><div class=\"card\"><div class=\"hero\"><span class=\"hero-icon\">🔒</span><h1>Private Auction Room</h1><p>You've been invited to join an exclusive auction</p></div><div class=\"body\"><p class=\"greeting\">Hello {{bidderName}},</p><div class=\"invite-box\"><span class=\"badge\">⭐ Invited Bidder</span><h2>You're invited!</h2><p>You have been selected to participate in an exclusive private auction room for:</p><span class=\"listing-title\">{{listingTitle}}</span><div class=\"details\"><div class=\"detail-row\"><span class=\"detail-label\">Current price</span><span class=\"detail-value price\">${{currentPrice}}</span></div><div class=\"detail-row\"><span class=\"detail-label\">Room starts</span><span class=\"detail-value\">{{endDate}}</span></div></div></div><p style=\"margin:20px 0;color:#4a5568;font-size:15px\">Respond within <strong>15 minutes</strong> to confirm your participation. If you accept, you will be taken to the listing page where you can enter the private room once it starts.</p><div class=\"cta-wrap\"><a href=\"{{acceptInvitationUrl}}\" class=\"cta-btn-accept\">✓ Accept</a><a href=\"{{declineInvitationUrl}}\" class=\"cta-btn-decline\">✗ Reject</a></div><div class=\"info\"><p><strong>What happens next?</strong></p><p>If you <strong>Accept</strong>: you will be redirected to the listing page. Once the private room opens, only accepted bidders can place bids. Each bid extends the room by 60 seconds.</p><p>If you <strong>Reject</strong>: your seat will be released and you will not participate in the private auction.</p></div><div class=\"closing\"><p>Best regards,</p><p><strong>The BidRoom Team</strong></p></div></div><div class=\"footer\"><p>This is an automated message. Please do not reply.</p></div></div></div></body></html>"
}
