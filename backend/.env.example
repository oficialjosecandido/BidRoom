# BidRoom backend — environment variables template
# Copy to `.env` and fill in. Never commit `.env`.

# ─── Core ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:4200
# Optional explicit production URL (CORS allowlist).
FRONTEND_URL_PROD=
# Comma-separated extra exact origins allowed by CORS (e.g. preview deploys).
CORS_EXTRA_ORIGINS=
# Comma-separated subdomain suffixes accepted by CORS, e.g.
#   bidroom-frontend.azurestaticapps.net,preview.bidroom.com
# Each entry matches both the bare host and any deeper subdomain.
# Leave empty to disable subdomain wildcards.
CORS_ALLOWED_SUBDOMAINS=

# ─── MongoDB ─────────────────────────────────────────────────────────────────
# SRV URI (preferred). Database name will be `bidroom_prod` in production,
# `bidroom-dev` otherwise unless you append one to the URI.
MONGO_URI=
# Optional fallback if Atlas SRV DNS fails (Connect → Drivers → Standard string).
MONGO_URI_STANDARD=

# ─── Firebase Admin SDK ──────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Wrap value in quotes; use \n for newlines inside the PEM.
FIREBASE_PRIVATE_KEY=

# ─── Redis (Azure Cache for Redis or local) ──────────────────────────────────
REDIS_HOST=
# 6380 = TLS (Azure Cache), 6379 = plaintext (local).
REDIS_PORT=6380
REDIS_PASSWORD=

# ─── Azure Blob Storage (listing media) ──────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=listing-images

# ─── Email (Gmail SMTP / Nodemailer) ─────────────────────────────────────────
EMAIL_USER=
# App password — do NOT use the account password.
EMAIL_PASSWORD=
EMAIL_FROM=

# ─── Stripe ──────────────────────────────────────────────────────────────────
# sk_test_... for staging, sk_live_... for production. Leave empty to disable.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# ─── EasyPost (shipping label automation, optional) ──────────────────────────
EASYPOST_API_KEY=

# ─── Sightengine (image moderation fallback) ─────────────────────────────────
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# ─── Admins ──────────────────────────────────────────────────────────────────
# Comma-separated emails of users with admin access to /api/admin routes.
ADMIN_EMAILS=

# ─── Misc ────────────────────────────────────────────────────────────────────
# Random hex string used to hash reviewer IPs (rotate yearly).
REVIEW_IP_HASH_SECRET=

# ─── Feature flags ───────────────────────────────────────────────────────────
FEATURE_MEMBERSHIP_TIERS=false
FEATURE_CREATE_LISTING_OUTSIDE_PT=false
FEATURE_REQUIRE_NIF=false

# ─── Application Insights (optional — Azure observability) ───────────────────
# Connection string from Azure Portal → Application Insights → Overview.
APPLICATIONINSIGHTS_CONNECTION_STRING=
