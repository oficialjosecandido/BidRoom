# Copy to .env and fill in values. Never commit .env.

# App
NODE_ENV=
PORT=
FRONTEND_URL=
FRONTEND_URL_PROD=
# Public origin of this API. Used to build the email open-tracking pixel URL,
# which is fetched from the recipient's mail client and so cannot be relative.
BACKEND_PUBLIC_URL=
JWT_SECRET=
LOG_LEVEL=
ADMIN_EMAILS=
# Ops inbox for every new bid (default: pt.bidnow@gmail.com)
PLATFORM_BID_NOTIFY_EMAIL=pt.bidnow@gmail.com

# Meta (Facebook Page + Instagram) — social auto-posting.
# PAGE_ACCESS_TOKEN must be derived from a long-lived USER token, otherwise
# it expires in ~1h. Verify with: node scripts/test-meta.js
# Base URL for links that leave the platform (emails, social posts). Falls back
# to FRONTEND_URL_PROD, then FRONTEND_URL when it is not localhost. Set this when
# running scripts locally, so outbound links never point at your own machine.
SOCIAL_PUBLIC_URL=

FB_APP_ID=
FB_APP_SECRET=
FB_PAGE_ID=
PAGE_ACCESS_TOKEN=
# Instagram Business account id linked to the Page above.
IG_USER_ID=
# Graph API version (default: v21.0)
META_GRAPH_VERSION=
# "true" posts every listing approved in Nexus to the Page and Instagram.
# Production only: it is refused when MONGO_URI names a dev/test/staging database.
SOCIAL_AUTOPOST=
# The Facebook/Instagram buttons in Nexus are refused on a dev/test/staging
# database too, unless this is "true" — the accounts are the real public ones.
SOCIAL_ALLOW_DEV_DATA=

# Feature flags
FEATURE_CREATE_LISTING_OUTSIDE_PT=
FEATURE_MEMBERSHIP_TIERS=
FEATURE_REQUIRE_NIF=

# CORS
CORS_ALLOWED_SUBDOMAINS=
CORS_EXTRA_ORIGINS=

# Database
MONGO_URI=
MONGO_URI_STANDARD=
MONGODB_URI=
MONGO_BOOT_ATTEMPTS=

# Redis
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# Stripe
STRIPE_MODE=
STRIPE_SECRET_KEY=
STRIPE_SECRET_KEY_LIVE=
STRIPE_SECRET_KEY_TEST=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_CONNECT_ACCOUNT_WEBHOOK_SECRET=
STRIPE_IDENTITY_WEBHOOK_SECRET=
STRIPE_BUSINESS_URL=
SKIP_STRIPE_VALIDATION=

# Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Azure Storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=

# Azure Content Safety (image/text moderation)
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=

# Sightengine (alternative moderation provider)
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# Shipping
EASYPOST_API_KEY=

# Email (transactional)
EMAIL_FROM=
EMAIL_USER=
EMAIL_PASSWORD=
# Ethereal (dev/test email preview — https://ethereal.email)
ETHEREAL_USER=
ETHEREAL_PASS=

# Reviews
REVIEW_IP_HASH_SECRET=

# Observability
APPLICATIONINSIGHTS_CONNECTION_STRING=
