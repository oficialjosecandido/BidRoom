# Application
NODE_ENV=development
PORT=3000
API_VERSION=v1

# MongoDB
MONGODB_URI=mongodb://localhost:27017/bidroom
MONGODB_USER=admin
MONGODB_PASSWORD=admin123

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=30d

# Azure AD B2C
AZURE_AD_B2C_TENANT_NAME=yourtenant
AZURE_AD_B2C_CLIENT_ID=your-client-id
AZURE_AD_B2C_CLIENT_SECRET=your-client-secret
AZURE_AD_B2C_POLICY_NAME=B2C_1_signupsignin
AZURE_AD_B2C_REDIRECT_URI=http://localhost:4200/auth/callback

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=your-storage-connection-string
AZURE_STORAGE_CONTAINER_NAME=bidroom-images

# Stripe Payment
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Application URLs
FRONTEND_URL=http://localhost:4200
BACKEND_URL=http://localhost:3000

# Auction Settings
MIN_BID_INCREMENT=1.00
PRIVATE_ROOM_MIN_BIDDERS=15
PRIVATE_ROOM_TOP_BIDDERS=5
PRIVATE_ROOM_EXTEND_TIME_MINUTES=1
PRIVATE_ROOM_NO_BID_CLOSE_MINUTES=2
PRE_AUTH_AMOUNT=5.00
PRE_AUTH_VALIDITY_DAYS=30

# Commission Rates (percentages)
COMMISSION_NO_PRIVATE_ROOM=0.5
COMMISSION_WITH_PRIVATE_ROOM=2.0

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log
