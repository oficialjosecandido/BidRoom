# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bidroom_prod
MONGO_URI_STANDARD=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bidroom_prod

# ─── Firebase Admin ───────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=rediss://<host>:<port>
REDIS_PASSWORD=your-redis-password

# ─── EasyPost (Shipping) ──────────────────────────────────────────────────────
EASYPOST_API_KEY=EZTKxxxxxxxxxxxxx

# ─── URLs ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://bidroom.com
FRONTEND_URL_PROD=https://bidroom.com
# Optional: extra browser origins (comma-separated), e.g. staging or www vs apex
# CORS_EXTRA_ORIGINS=https://www.bidroom.com,https://staging.bidroom.com

# ─── Admin ────────────────────────────────────────────────────────────────────
# Comma-separated list of admin email addresses
ADMIN_EMAILS=admin@bidroom.com

# ─── Feature Flags ────────────────────────────────────────────────────────────
FEATURE_MEMBERSHIP_TIERS=false

# ─── Dev only (do NOT set in production) ─────────────────────────────────────
# SKIP_STRIPE_VALIDATION=true
